generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Utilisateurs & rôles ────────────────────────────────────────

enum Role {
  COACH
  ATHLETE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(ATHLETE)
  createdAt     DateTime  @default(now())

  accounts         Account[]
  sessions         Session[]
  coachedSessions  TrainingSession[] @relation("CoachSessions")
  assignedSessions TrainingSession[] @relation("AthleteSessions")
  exercisesCreated Exercise[]
}

// Tables requises par Auth.js (adapter Prisma)

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Bibliothèque d'exercices ────────────────────────────────────

model Exercise {
  id          String   @id @default(cuid())
  name        String   @unique
  category    String? // ex : "Haut du corps", "Jambes", "Station Hyrox", "Cardio"…
  description String?
  createdAt   DateTime @default(now())

  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  sessionExercises SessionExercise[]
}

// ── Séances ─────────────────────────────────────────────────────

enum SessionType {
  CARDIO
  CROSSFIT
  HYROX
  MUSCULATION
}

enum SessionStatus {
  ASSIGNED
  COMPLETED
}

model TrainingSession {
  id          String        @id @default(cuid())
  title       String
  type        SessionType
  date        DateTime      @db.Date
  status      SessionStatus @default(ASSIGNED)
  coachNotes  String? // consignes générales du coach
  athleteNotes String? // ressenti global de l'athlète
  sessionRpe  Int? // RPE global de la séance (1-10)
  completedAt DateTime?
  createdAt   DateTime      @default(now())

  coach     User   @relation("CoachSessions", fields: [coachId], references: [id])
  coachId   String
  athlete   User   @relation("AthleteSessions", fields: [athleteId], references: [id])
  athleteId String

  blocks SessionBlock[]

  @@index([athleteId, date])
  @@index([coachId, date])
}

// Format d'un bloc de séance : détermine le formulaire de prescription
// (coach) et de saisie (athlète).
enum BlockFormat {
  STANDARD // exercices en séries classiques (musculation, cardio simple)
  SUPERSET // exercices alternés sur N tours
  INTERVALS // fractionné : N répétitions effort/récup
  AMRAP // max de tours dans un temps donné
  FOR_TIME // enchaînement chronométré
  EMOM // une consigne par minute pendant N minutes
}

// Une séance est composée de blocs ordonnés. Le bloc porte le format,
// ses paramètres (tours, temps plafond, récupération) et — pour les
// formats chronométrés — le résultat global saisi par l'athlète.
model SessionBlock {
  id       String      @id @default(cuid())
  position Int
  format   BlockFormat @default(STANDARD)
  title    String? // ex : "WOD", "Finisher", "Bloc seuil"

  rounds      Int? // tours (superset, For Time, intervalles)
  durationSec Int? // temps plafond AMRAP / durée totale EMOM / effort par intervalle
  restSec     Int? // récupération entre tours ou intervalles
  notes       String?

  // Résultat de bloc (athlète) — selon le format
  resultTimeSec   Int? // For Time : temps total
  resultRounds    Int? // AMRAP : tours complets ; EMOM : minutes réussies
  resultExtraReps Int? // AMRAP : répétitions du tour entamé
  resultRpe       Int? // 1-10
  resultNotes     String?

  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String

  exercises SessionExercise[]

  @@unique([sessionId, position])
}

// Un exercice de la bibliothèque placé dans un bloc, avec la
// prescription du coach. Toutes les cibles sont optionnelles : on ne
// remplit que celles qui ont du sens pour le format du bloc.
model SessionExercise {
  id       String @id @default(cuid())
  position Int // ordre dans le bloc

  // Prescription (cible fixée par le coach)
  targetSets        Int?
  targetReps        Int? // reps par série / par tour / par minute selon le format
  targetWeightKg    Float?
  targetDurationSec Int?
  targetDistanceM   Float?
  instructions      String? // texte libre (tempo, variation, allure…)

  block   SessionBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  blockId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  exerciseId String

  performanceSets PerformanceSet[]

  @@unique([blockId, position])
  @@index([exerciseId])
}

// Réalisation de l'athlète : une ligne par série (ou par segment pour
// le cardio). Modèle flexible : chaque métrique est optionnelle, on
// renseigne celles qui s'appliquent (reps, charge, temps, distance, RPE).
model PerformanceSet {
  id        String @id @default(cuid())
  setNumber Int

  reps        Int?
  weightKg    Float?
  durationSec Int?
  distanceM   Float?
  rpe         Int? // 1-10
  notes       String?
  createdAt   DateTime @default(now())

  sessionExercise   SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)
  sessionExerciseId String

  @@unique([sessionExerciseId, setNumber])
}
