# Chaîne de connexion PostgreSQL.
# Local : postgresql://user:password@localhost:5432/suivi_sport
# Neon (production) : postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# Auth.js — générer avec : openssl rand -base64 32
AUTH_SECRET=""

# URL publique de l'app. Inutile sur Vercel (détectée automatiquement) ;
# en local : http://localhost:3000
AUTH_URL="http://localhost:3000"

# Google OAuth — voir DEPLOY.md §2.
# Redirect URI à déclarer : <URL de l'app>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Seuls ces emails peuvent se connecter (séparés par des virgules).
ALLOWED_EMAILS="coach@example.com,vous@example.com"
# Les emails listés ici reçoivent le rôle COACH à la connexion.
COACH_EMAILS="coach@example.com"

# Connexion dev sans Google (boutons Coach/Athlète sur la page de login).
# Uniquement en local — ignorée sur Vercel quoi qu'il arrive.
AUTH_DEV_LOGIN="false"
