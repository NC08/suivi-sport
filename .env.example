# Chaîne de connexion PostgreSQL (Neon, Supabase, Railway, ou local)
DATABASE_URL="postgresql://user:password@host:5432/suivi_sport"

# Auth.js — générer avec : openssl rand -base64 32
AUTH_SECRET=""
# URL publique de l'app (ex : https://suivi-sport.vercel.app)
AUTH_URL="http://localhost:3000"

# Google OAuth — créer un client OAuth sur https://console.cloud.google.com/apis/credentials
# Redirect URI à déclarer : <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Seuls ces emails peuvent se connecter (séparés par des virgules).
ALLOWED_EMAILS="coach@example.com,vous@example.com"
# Les emails listés ici reçoivent le rôle COACH à la connexion.
COACH_EMAILS="coach@example.com"

# Mettre à "true" UNIQUEMENT en local : active la connexion dev sans Google.
AUTH_DEV_LOGIN="false"
